# Copy to ".env" in the repo root (or host/.env) and fill in what you have.
# The stack boots with local JSON + files when Discord is left empty.

# --- HTTP API (required for Cryax) ---
# Same value the Cryax client sends as x-api-secret / ?secret=
API_SECRET=bloodontop
HOST=0.0.0.0
PORT=8787

# Public URL other machines use to reach THIS process.
# Leave as localhost while you test on the same PC as the executor.
# For a loadstring that never changes, set this to a hostname on a domain
# you own (https://api.yourname.com) — not trycloudflare.com, not www.cryax.
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Permanent workers.dev host for the loadstring AND nametag API.
# CONTROL copies this. Leave as the official URL unless you run a different Worker.
WORKER_BASE_URL=https://cryax-api.cryaxontop.workers.dev

# open      = anyone can run the script (default, easiest self-host)
# whitelist = only Roblox IDs added with /staff whitelist
# key       = must present a key created with /staff key
ACCESS_MODE=open

# Comma-separated Roblox user ids that always get the in-game Staff panel
# (also baked into cryax src.lua as STAFF_IDS). Extra people: /staff panel.
STAFF_ROBLOX_IDS=10826781066,117954898,11193603826

# How long a heartbeat keeps someone "online" (client posts every ~3s)
PRESENCE_TTL_SECONDS=15

# Folder for local JSON + image files
DATA_DIR=data

# --- Discord bot (optional; API still runs without it) ---
# Create an application at https://discord.com/developers/applications
# Put the bot token in .env (gitignored), never in this example file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1549925348840317038
# Optional: sync slash commands to one guild instantly (your server id)
DISCORD_GUILD_ID=1551210301041418242
# Your Discord user id. Always has owner perms on the bot.
# Extra owners: /ownerwhitelist add @user
# Extra people who may use the bot: /botwhitelist add @user
DISCORD_OWNER_ID=1330465176297668651
# Extra Discord user ids that can use /staff (comma-separated). These people can
# grant the in-game Staff panel with /staff panel; they do not get verified.
# Staff can also use the bot without being on /botwhitelist.
STAFF_DISCORD_IDS=1347721637721800734
# Prefix for .nametagpanel (include the dot)
COMMAND_PREFIX=.

# Optional password for the CONTROL dashboard at http://127.0.0.1:8787
# Leave empty to keep the panel open on this computer.
CONTROL_PASSWORD=

# Optional. If empty, CONTROL uses CLOUDFLARE_TUNNEL_TOKEN, then a quick
# `cloudflared tunnel --url ...` (URL changes every restart), then ngrok.
TUNNEL_COMMAND=
# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
# Windows service (needs Administrator PowerShell once):
#   cd host ; .\install-tunnel.ps1
# Leave this empty after the service is installed so CONTROL does not
# start a second cloudflared. Still set PUBLIC_BASE_URL to the hostname.
# If you cannot use Administrator, paste the token here and set
# AUTO_START_TUNNEL=1 so hidden CONTROL runs `cloudflared tunnel run --token`.
CLOUDFLARE_TUNNEL_TOKEN=
# 1 = start Discord bot when the host boots (needs DISCORD_TOKEN)
AUTO_START_DISCORD=1
# 1 = start a tunnel from CONTROL. Keep 0 if cloudflared is a Windows service.
AUTO_START_TUNNEL=0
